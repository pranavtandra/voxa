# Optional. Voxa works fully without this value using its private local language engine.
GEMINI_API_KEY=

# Public browser credentials for Voxa authentication and per-user sync.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional free hosted error reporting. The DSN is public, but events are redacted in code.
NEXT_PUBLIC_SENTRY_DSN=
